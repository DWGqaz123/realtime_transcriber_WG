####################################
# macOS
####################################
.DS_Store
.AppleDouble
.LSOverride

####################################
# Python / FastAPI
####################################
# Byte-compiled / optimized
__pycache__/
*.py[codz]
*$py.class

# Virtual environments
.env
.envrc
.venv
venv/
env/
ENV/
*_env/

# Python packaging / build
build/
dist/
.eggs/
*.egg-info/
*.egg
MANIFEST
.installed.cfg
wheels/
share/python-wheels/

# Logs
*.log

# Test / coverage
htmlcov/
.coverage
.coverage.*
.cache
.pytest_cache/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.pytype/
.pyre/
.ruff_cache/

####################################
# Backend – runtime / generated data
####################################
# FastAPI runtime logs or artifacts
backend/runs/

# Generated transcripts (runtime data)
backend/transcripts/

# Model cache / embeddings / runtime models
backend/models/

# Backend build artifacts
backend/build/
backend/dist/
backend/*.spec
# backend.spec 是构建产物的配方，必须入库（曾经被这条规则误伤过）
!backend/backend.spec

####################################
# Jupyter / IPython
####################################
.ipynb_checkpoints/
profile_default/
ipython_config.py

####################################
# Documentation build
####################################
docs/_build/
site/

####################################
# Xcode / Swift (macOS App)
####################################
# Build & derived data
DerivedData/
build/

# User-specific Xcode files
*.xcuserstate
*.xcuserdata/
*.xcworkspace/xcuserdata/
# .xcodeproj 下的目录名就叫 xcuserdata，上面两条匹配不到
**/xcuserdata/

####################################
# IDEs / Editors
####################################
# VS Code
.vscode/

# JetBrains
.idea/

# Cursor editor
.cursorignore
.cursorindexingignore

####################################
# Package manager configs (do not commit secrets)
####################################
.pypirc

####################################
# Disk images / installers
####################################
*.dmg
*.app
dmg_temp_*/
RealtimeTranscriberMac */

####################################
# OS / misc
####################################
Thumbs.db
# App configuration / secrets
config.plist

# Prevent accidental backend copies in frontend
frontend_mac/**/backend*

dist/
build/

# 注意：这里不要写裸的 database/。仓库里的 backend/database/ 是源码目录
# （db.py / models.py），那条规则会把新增源码静默忽略掉——backend.spec
# 就是被同类规则（backend/*.spec）吃掉过一次，导致打包链路断了几个月。
# 真正的数据库文件在 ~/Library/Application Support/RealtimeTranscriber/，
# 根本不在仓库里。下面这条只作为防御，万一有人往源码目录写 db 文件。
backend/database/*.db
